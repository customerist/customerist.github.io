---
import logo from '../assets/images/logo.png';
import { site } from '../config';
import Img from './Img.astro';
---

<footer id="footer" class="footer-light-2">
  <div class="container-17">
    <div class="footer-wrapper-two-2">
      <div class="w-layout-blockcontainer footer-brand w-container">
        <Img src={logo} alt="Customerist" width={330} />
        <p class="paragraph-4">
          <br />Got a question or a challenge?<br />Email us at <a class="bold-text-12" href={`mailto:${site.email}`}>{site.email}</a><br />or drop us a
          message here.
        </p>
        <p class="footer-social">
          <a href={site.linkedIn} target="_blank" rel="noopener">Follow us on LinkedIn&nbsp;↗</a>
        </p>
      </div>
      <div class="form-block w-form">
        <form
          id="email-form"
          name="email-form"
          class="form"
          method="post"
          enctype="text/plain"
          action={`mailto:${site.email}`}
          data-email={site.email}
          data-access-key={site.web3formsAccessKey}
        >
          <label for="name">Name</label>
          <input class="w-input" maxlength="256" name="name" type="text" id="name" autocomplete="name" />
          <label for="email">Email Address</label>
          <input class="w-input" maxlength="256" name="email" type="email" id="email" autocomplete="email" required />
          <label for="Message">Message</label>
          <textarea class="w-input" name="Message" id="Message" rows="5" required></textarea>
          <!-- Web3Forms drops any submission that ticks this. People never see it. -->
          <input type="checkbox" name="botcheck" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="submit" data-wait="Please wait..." class="submit-button w-button" value="Send message" />
          {!site.web3formsAccessKey && <p class="form-note">Sending opens your email app with this message filled in.</p>}
        </form>
        <div class="w-form-done" role="status" tabindex="-1"><div>Thank you! Your message has been sent.</div></div>
        <div class="w-form-fail" role="alert">
          <div>Your message didn't send. It's still in the form. Try again, or email us at <a href={`mailto:${site.email}`}>{site.email}</a>.</div>
        </div>
        <div class="form-status" role="status" hidden>
          Your email app should have opened with your message ready to send. If nothing happened, write to us at{' '}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('#email-form');

  if (form) {
    const done = form.parentElement!.querySelector<HTMLElement>('.w-form-done')!;
    const fail = form.parentElement!.querySelector<HTMLElement>('.w-form-fail')!;
    const handedOff = form.parentElement!.querySelector<HTMLElement>('.form-status')!;
    const submit = form.querySelector<HTMLInputElement>('input[type="submit"]')!;
    const { accessKey, email } = form.dataset;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const from = String(data.get('email') ?? '').trim();
      const message = String(data.get('Message') ?? '').trim();

      // Until a Web3Forms access key is set in src/config.ts, hand the message
      // to the visitor's mail client and say so, because nothing else on the
      // page changes when that works.
      if (!accessKey) {
        const subject = `Website enquiry${name ? ` from ${name}` : ''}`;
        const body = `${message}\n\n${name}\n${from}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        handedOff.hidden = false;
        return;
      }

      const label = submit.value;
      submit.value = submit.dataset.wait ?? label;
      submit.disabled = true;
      fail.style.display = 'none';
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: accessKey,
            subject: `Website enquiry${name ? ` from ${name}` : ''}`,
            from_name: 'Customerist website',
            name,
            email: from,
            message,
            botcheck: data.get('botcheck') === 'on',
          }),
        });
        // Web3Forms can answer 200 with success: false, so check both.
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.success) throw new Error(`Web3Forms returned ${response.status}`);
        form.style.display = 'none';
        done.style.display = 'block';
        done.focus();
      } catch {
        fail.style.display = 'block';
      } finally {
        submit.value = label;
        submit.disabled = false;
      }
    });
  }
</script>
