---
import quoteMark from '../assets/images/quote-mark.png';
import type { CaseStudy } from '../data/case-studies';
import Img from './Img.astro';

interface Props {
  study: CaseStudy;
  number: number;
}

const { study, number } = Astro.props;
---

<!--
  Webflow set every display line on this page as an h1. The lines keep that
  look through the h1-look class, and the tags now say what each line is.
-->
<section class="section-3" aria-labelledby={`case-${number}`}>
  <div class="w-layout-blockcontainer container-19 w-container">
    <div class="w-layout-blockcontainer container-20 w-container">
      <div class="text-block-8">CASE&nbsp;STUDY&nbsp;# {number}</div>
      <h2 id={`case-${number}`} class="h1-look heading-14">{study.client}</h2>
      <div class="text-block-7">{study.disciplines}</div>
      <div class="h1-look heading-15">{study.headline}</div>
      <p class="paragraph-6" set:html={study.intro} />
    </div>
    <div class="w-layout-blockcontainer w-container">
      <Img src={study.introImage} width={530} sizes="(max-width: 767px) 100vw, 530px" class="image-9" />
    </div>
  </div>
  <div class="w-layout-blockcontainer container-22 w-container">
    <div class="w-layout-blockcontainer container-21 w-container">
      <p class="paragraph-7">
        <strong class="bold-text-13">THE&nbsp;CHALLENGE<br /><br /></strong><Fragment set:html={study.challenge} />
      </p>
      <div class="h1-look heading-16" set:html={study.challengeHeadline} />
    </div>
    <div class="w-layout-blockcontainer container-23 w-container">
      <p class="paragraph-8">
        <strong class="bold-text-14">WHAT&nbsp;WE&nbsp;DID<br /><br /></strong><Fragment set:html={study.whatWeDid} />
      </p>
      <ol class="w-row case-steps">
        {
          study.steps.map((step, index) => (
            <li class="w-col w-col-3">
              <div class="h1-look heading-17" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </div>
              <div class="text-block-12">
                <strong>{step.title}</strong>
              </div>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
  <div class="w-layout-blockcontainer container-24 w-container">
    <div class="w-layout-blockcontainer container-25 w-container">
      <p><strong class="bold-text-16">WHAT&nbsp;CHANGED</strong></p>
      <div class="h1-look heading-18" set:html={study.whatChangedHeadline} />
      <p set:html={study.whatChanged} />
    </div>
    <div class="w-layout-blockcontainer container-26 w-container">
      <Img src={study.whatChangedImage} width={407} sizes="(max-width: 479px) 100vw, 407px" class="image-12" />
    </div>
  </div>
  <figure class="case-quote">
    <div class="w-layout-blockcontainer container-27 w-container">
      <div class="w-layout-blockcontainer container-29 w-container">
        <Img src={quoteMark} width={61} class="image-11" />
        <div class="h1-look heading-19" set:html={study.quote} />
      </div>
      <div class="w-layout-blockcontainer container-28 w-container">
        <figcaption class="text-block-14" set:html={study.attribution} />
      </div>
    </div>
  </figure>
  <div class="w-layout-blockcontainer w-container case-cta">
    <a href="#footer">Facing something similar? Tell us what's stuck&nbsp;↓</a>
  </div>
</section>
<section class="divider"></section>
