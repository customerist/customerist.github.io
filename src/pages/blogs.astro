---
import '../styles/blog.css';
import Img from '../components/Img.astro';
import { formatDate, getPosts } from '../data/posts';
import Base from '../layouts/Base.astro';

const posts = await getPosts();
---

<Base title="Blogs | Customerist" description="Notes on customer strategy, CRM, loyalty and customer experience from the Customerist team.">
  <section class="blog-header">
    <h1 class="main-heading">Blogs</h1>
    <p class="blog-header__lead">Notes on customer strategy, CRM, loyalty and customer experience from the Customerist team.</p>
  </section>

  <section class="blog-list" aria-label="Posts">
    {
      posts.length === 0 ? (
        <p class="blog-empty">
          No posts yet. In the meantime, <a href="/casestudies">read our case studies</a>.
        </p>
      ) : (
        <ol class="blog-gallery">
          {posts.map((post) => (
            <li class="blog-tile">
              <div class="blog-tile__cover">
                {post.data.cover ? (
                  <Img
                    src={post.data.cover}
                    alt=""
                    sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 340px"
                    class="blog-tile__img"
                  />
                ) : (
                  <div class="blog-tile__placeholder" aria-hidden="true">
                    {post.data.title}
                  </div>
                )}
              </div>
              <div class="blog-tile__caption">
                <h2 class="blog-tile__title">
                  <a href={`/blogs/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="blog-meta">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.author && ` · ${post.data.author}`}
                  {post.data.draft && <span class="blog-draft">Draft, not published</span>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Base>
