---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Customerist" description="The page you are looking for doesn't exist or has been moved.">
  <section class="hero-heading-left">
    <div class="hero-wrapper">
      <div class="hero-split">
        <h1 class="main-heading">Page not found</h1>
        <p class="margin-bottom-24px">The page you are looking for doesn't exist or has been moved.</p>
        <a href="/" class="button w-button">Back to the homepage</a>
      </div>
    </div>
  </section>
</Base>
